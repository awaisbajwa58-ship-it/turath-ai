# تراث اے آئی (Turath AI) - ماحولیاتی متغیرات (Environment Variables)

# 1. Google Gemini API Key (ضروری)
# گوگل اے آئی اسٹوڈیو (https://aistudio.google.com) سے حاصل کریں
GEMINI_API_KEY="AIzaSy..."

# 2. سرور پورٹ (لوکل ڈیولپمنٹ کے لیے)
PORT=3000

# 3. AI ماڈل کا نام (اختیاری، ڈیفالٹ: gemini-3.6-flash)
AI_MODEL="gemini-3.6-flash"
